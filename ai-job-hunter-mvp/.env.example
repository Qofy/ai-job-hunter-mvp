# Backend: set environment variables before launching (no cloud service required).
# Optional: defaults to %LOCALAPPDATA%/JobPilotAI on Windows; must be outside this repo.
# JOBPILOT_DATA_DIR=C:/Users/YOUR_USER/AppData/Local/JobPilotAI
FRONTEND_ORIGIN=http://localhost:3000
# Frontend (copy to frontend/.env.local)
BACKEND_API_URL=http://127.0.0.1:8000
