# Backend: set environment variables before launching (no cloud service required).
# Optional: defaults to %LOCALAPPDATA%/JobPilotAI on Windows; must be outside this repo.
# JOBPILOT_DATA_DIR=C:/Users/YOUR_USER/AppData/Local/JobPilotAI
FRONTEND_ORIGIN=http://localhost:3000
# Worker runs while FastAPI is open; automatic sending also requires saved policy/connection.
# JOBPILOT_AGENT_ENABLED=1
# Fictional fixture routes are disabled outside explicit test/demo environments.
# JOBPILOT_ENABLE_DEMO=0
# Optional automatic Claude writing (manual subscription workflow needs neither).
# Keep these backend-only; never use a NEXT_PUBLIC_ prefix for secrets.
# ANTHROPIC_API_KEY=your_api_key
# CLAUDE_MODEL=your_enabled_model_id_supporting_structured_outputs
# Frontend (copy to frontend/.env.local)
BACKEND_API_URL=http://127.0.0.1:8000
